# Скопируйте в .env и подставьте свои значения. Файл .env в Git не попадает.
# Ключи нужны только при запуске вне ВМ Yandex Cloud. На ВМ с привязанным
# сервисным аккаунтом скрипты берут IAM-токен из сервиса метаданных.
# export AWS_ACCESS_KEY_ID=идентификатор_статического_ключа
# export AWS_SECRET_ACCESS_KEY=секретный_ключ
export S3_ENDPOINT=https://storage.yandexcloud.net
export S3_REGION=ru-central1
export BUCKET=имя_бакета
